# --- DATABASE CONFIGURATION ---
POSTGRES_USER=cdms_user
POSTGRES_PASSWORD=cdms_password
POSTGRES_DB=cdms_db

# --- SECURITY ---
# Generate with: openssl rand -hex 32
SECRET_KEY=e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9

# --- REDIS ---
REDIS_URL=redis://redis:6379/0

# --- API & FRONTEND ---
VITE_API_URL=http://localhost/api
FRONTEND_PORT=80

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- COOKIE ---
# False for local dev (no HTTPS). Must be True in production.
COOKIE_SECURE=False

# --- AI INTEGRATION ---
# Get your key at: https://aistudio.google.com/
# Do NOT commit real keys. Set this in your deployment environment.
GEMINI_API_KEY=
# Model to use — change to any supported Gemini model
# e.g. gemini-2.0-flash-lite, gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-3.1-flash-lite-preview
